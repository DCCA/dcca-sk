# Config ainda pertencente ao dcca-sk. O install.sh copia dotfiles/<tool>/ para
# o target e o capture.sh traz de volta. Delimitado por '|'.
#
#   <tool> | <target-linux> | <target-mac> | <target-wsl> | <exclude,globs> | <mode>
#
# Configuracao de agentes e skills de terceiros ficam no dcca-env e nao aparecem
# neste manifesto. O target '-' significa pular neste OS.
# '$WINHOME' (no target-wsl) vira o home do Windows via wslpath.
# exclude: arquivos/dirs nunca copiados nem capturados (segredo/estado local).
# mode 'copy' sobrescreve com backup; 'seed' so escreve se o target nao existe e
# nunca captura, para config que acumula estado local.

vscode | ~/.config/Code/User | ~/Library/Application Support/Code/User | $WINHOME/AppData/Roaming/Code/User | extensions.txt | seed
shell  | ~/.config/dcca-sk | ~/.config/dcca-sk | ~/.config/dcca-sk | - | copy
