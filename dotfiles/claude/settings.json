{
  "permissions": {
    "allow": [
      "mcp__pencil"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-gate.sh\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/stop-gate.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "CLAUDE_STATUSLINE_NERDFONT=1 CLAUDE_STATUSLINE_POWERLINE=0 bash \"$HOME/.claude/statusline.sh\"",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "imessage@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "skill-creator@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skillOverrides": {
    "social": "off",
    "orchestration": "off",
    "orca-cli": "off",
    "imagegen-frontend-web": "off",
    "imagegen-frontend-mobile": "off",
    "image-to-code": "off",
    "daily-review": "off",
    "gpt-taste": "off",
    "industrial-brutalist-ui": "off",
    "design-taste-frontend-v1": "off",
    "stitch-design-taste": "off",
    "full-output-enforcement": "off",
    "plannotator-review": "off",
    "plannotator-annotate": "off",
    "plannotator-last": "off"
  }
}
